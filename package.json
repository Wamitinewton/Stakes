{
  "name": "stakes-workspace",
  "private": true,
  "description": "Know what's riding on every work item. A Forge app for Jira, plus an optional bridge app.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/stakes",
    "apps/stakes-bridge"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @stakes/contracts",
    "typecheck": "tsc -b packages/contracts && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
